nodejs-project/default/
nodejs-project/plugins/
nodejs-project/post-install.js
nodejs-project/node_modules/

# Build artifacts — generated by prepare-ios.sh / bundle-server.mjs
nodejs-project/server-bundle.mjs
/nodejs-project-deploy/
nodejs-project/bundle-audit.json
nodejs-project/assets/
nodejs-project/plugins.js
nodejs-project-deploy/assets/
nodejs-project-deploy/src/
nodejs-project-deploy/runtime-manifest.json
nodejs-project-deploy/THIRD-PARTY-NOTICES.txt
nodejs-project-deploy/LICENSE
nodejs-project-deploy/server-bundle.mjs
nodejs-project-deploy/plugins/
nodejs-project-deploy/config.yaml
nodejs-project-deploy/package.json

# Xcode generated files
ios/App/App/public/
ios/App/Pods/
ios/App/*.xcworkspace/xcuserdata/
ios/App/*.xcodeproj/xcuserdata/
ios/App/App.xcworkspace/xcuserdata/
ios/App/DerivedData/
ios/.build/
ios/build-validation/
ios/build-chat-validation/
ios/AppUITest-results/

# CocoaPods lockfile (generated)
ios/App/Podfile.lock
